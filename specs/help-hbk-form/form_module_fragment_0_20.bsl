#Область СинтаксисПомощник

// Загрузка штатных файлов синтакс-помощника платформы (shcntx_*.hbk — объектная модель,
// shlang_*.hbk — встроенный язык, shquery_*.hbk — язык запросов, dcsui_*.hbk — СКД)
// через универсальный Base64-мост консоли.
//
// Основа — образец из релизной обработки автора (console.epf 0.5.3): ПолучитьФайлСправки и чтение
// файла порциями по 1 МБ с передачей через beginBase64Transfer / pushBase64Chunk / endBase64Transfer.
// Отличия: путь хранится в настройках и ищется автоматически, передача разложена по тактам
// обработчика ожидания (форма не встаёт на ~40 МБ объектной модели), рядом подхватывается пакет
// встроенного языка, ход выполнения виден в надписи.

&НаКлиенте
Функция ПолучитьФайлСправки(ИмяФайла)

	Результат = НайтиФайлы(КаталогПрограммы(), ИмяФайла, Ложь);

	Если 0 < Результат.Количество() Тогда
		Возврат Результат[0];
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

&НаКлиенте
Функция РазмерПорцииСинтаксисПомощника()

	Возврат 1024 * 1024;

КонецФункции

&НаКлиенте
Функция ПорцийЗаТакт()

	Возврат 4;

КонецФункции

&НаКлиенте
Процедура ИнициализироватьНастройкиСинтаксисПомощника()

	#Если ВебКлиент Тогда
		Элементы.ГруппаНастроекСинтаксисПомощник.Видимость = Ложь;
		Возврат;
	#КонецЕсли

	Если НЕ ЗначениеЗаполнено(ФайлСинтаксисПомощника) Тогда
		ФайлСинтаксисПомощника = НайтиФайлСинтаксисПомощника();
	КонецЕсли;

	Если ЗначениеЗаполнено(ФайлСинтаксисПомощника) Тогда
		ПоказатьСостояниеСинтаксисПомощника("файл найден, ещё не загружен");
	Иначе
		ПоказатьСостояниеСинтаксисПомощника("файл shcntx_*.hbk не найден, укажите путь вручную");
	КонецЕсли;

КонецПроцедуры

// Пакет объектной модели лежит там, где его кладёт платформа: сначала каталог запущенного
// приложения (как в обработке автора), затем соседние каталоги версий этой же установки.
&НаКлиенте
Функция НайтиФайлСинтаксисПомощника()

	Файл = ПолучитьФайлСправки("shcntx_ru.hbk");

	Если Файл <> Неопределено Тогда
		Возврат Файл.ПолноеИмя;
	КонецЕсли;

	Для Каждого Каталог Из КаталогиСоседнихВерсийПлатформы() Цикл

		Путь = Каталог + "shcntx_ru.hbk";
		ФайлВерсии = Новый Файл(Путь);

		Если ФайлВерсии.Существует() Тогда
			Возврат Путь;
		КонецЕсли;

	КонецЦикла;

	Возврат "";

КонецФункции

&НаКлиенте
Функция КаталогиСоседнихВерсийПлатформы()

	Разделитель = ПолучитьРазделительПути();
	Каталоги = Новый Массив;

	Попытка
		КаталогПриложения = ДополнитьРазделителем(КаталогПрограммы(), Разделитель);
	Исключение
		// каталог программы недоступен — остаётся ручной выбор файла
		Возврат Каталоги;
	КонецПопытки;

	// bin -> <версия> -> корень установки платформы; версии перебираем от свежих к старым
	// (сортировка строковая, поэтому она лишь дополняет каталог запущенного приложения).
	ФайлКаталогаBin = Новый Файл(Лев(КаталогПриложения, СтрДлина(КаталогПриложения) - 1));
	КаталогВерсии = ФайлКаталогаBin.Путь;

	ФайлКаталогаВерсии = Новый Файл(Лев(КаталогВерсии, СтрДлина(КаталогВерсии) - 1));
	КореньУстановки = ФайлКаталогаВерсии.Путь;

	Если НЕ ЗначениеЗаполнено(КореньУстановки) Тогда
		Возврат Каталоги;
	КонецЕсли;

	Попытка
		Найденные = НайтиФайлы(КореньУстановки, "*", Ложь);
	Исключение
		Возврат Каталоги;
	КонецПопытки;

	Версии = Новый СписокЗначений;

	Для Каждого Найденный Из Найденные Цикл
		Если Найденный.ЭтоКаталог() Тогда
			Версии.Добавить(ДополнитьРазделителем(Найденный.ПолноеИмя, Разделитель) + "bin" + Разделитель);
		КонецЕсли;
	КонецЦикла;

	Версии.СортироватьПоЗначению(НаправлениеСортировки.Убыв);

	Для Каждого Элемент Из Версии Цикл
		Если Элемент.Значение <> КаталогПриложения Тогда
			Каталоги.Добавить(Элемент.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Каталоги;

КонецФункции

&НаКлиенте
Функция ДополнитьРазделителем(Путь, Разделитель)

	Возврат ?(Прав(Путь, 1) = Разделитель, Путь, Путь + Разделитель);

КонецФункции

// Профильные пакеты справки: язык запросов (режим bsl_query) и СКД (режим dcs_query).
&НаКлиенте
Функция ПрофильныеПакетыСправки()

	Пакеты = Новый Массив;
	Пакеты.Добавить("shquery");
	Пакеты.Добавить("dcsui");

	Возврат Пакеты;

КонецФункции

// Остальные пакеты платформы лежат рядом с объектной моделью и отличаются только префиксом имени.
&НаКлиенте
Функция ПутьКСоседнемуПакету(ПутьКОбъектнойМодели, ИмяПакета)

	Файл = Новый Файл(ПутьКОбъектнойМодели);

	Если СтрНайти(НРег(Файл.Имя), "shcntx") = 0 Тогда
		Возврат "";
	КонецЕсли;

	ПутьКПакету = Файл.Путь + СтрЗаменить(НРег(Файл.Имя), "shcntx", ИмяПакета);
	ФайлПакета = Новый Файл(ПутьКПакету);

	Возврат ?(ФайлПакета.Существует(), ПутьКПакету, "");

КонецФункции

&НаКлиенте
Функция ОписаниеПакетаСправки(Параметры)

	Вид = "";

	// params приходит из редактора объектом браузера, а не структурой 1С, поэтому читаем через Попытка
	Попытка
		Вид = Строка(Параметры.kind);
	Исключение
	КонецПопытки;

	Если Вид = "query" Тогда
		Возврат "язык запросов";
	ИначеЕсли Вид = "dcs" Тогда
		Возврат "СКД";
	КонецЕсли;

	Возврат "объектная модель";

КонецФункции

&НаКлиенте
Процедура ФайлСинтаксисПомощникаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Оповещение = Новый ОписаниеОповещения("ВыборФайлаСинтаксисПомощникаЗавершение", ЭтотОбъект);
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите файл синтакс-помощника (shcntx_*.hbk)";
	Диалог.Фильтр = "Файлы справки 1С (*.hbk)|*.hbk";
	Диалог.МножественныйВыбор = Ложь;
	Диалог.ПолноеИмяФайла = ФайлСинтаксисПомощника;
	Диалог.Показать(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ВыборФайлаСинтаксисПомощникаЗавершение(ВыбранныеФайлы, ДопПараметры) Экспорт

	Если ВыбранныеФайлы <> Неопределено И 0 < ВыбранныеФайлы.Количество() Тогда
		ФайлСинтаксисПомощника = ВыбранныеФайлы[0];
		ПоказатьСостояниеСинтаксисПомощника("файл выбран, нажмите «Загрузить синтаксис-помощник»");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСинтаксисПомощник(Команда)

	Если View().getHelpState().status <> "empty" Тогда
		View().showHelp();
	Иначе
		НачатьЗагрузкуСинтаксисПомощника();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АвтозапускЗагрузкиСинтаксисПомощника()

	Если ЗагружатьСинтаксисПомощникПриОткрытии И ЗначениеЗаполнено(ФайлСинтаксисПомощника) Тогда
		НачатьЗагрузкуСинтаксисПомощника();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НачатьЗагрузкуСинтаксисПомощника()

	Если ЗагрузкаСинтаксисПомощника <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ДокументЗагружен Тогда
		ПоказатьСостояниеСинтаксисПомощника("редактор ещё не готов, повторите позже");
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ФайлСинтаксисПомощника) Тогда
		ПоказатьСостояниеСинтаксисПомощника("не указан файл");
		Возврат;
	КонецЕсли;

	ФайлОбъектнойМодели = Новый Файл(ФайлСинтаксисПомощника);

	Если НЕ ФайлОбъектнойМодели.Существует() Тогда
		ПоказатьСостояниеСинтаксисПомощника("файл не найден: " + ФайлСинтаксисПомощника);
		Возврат;
	КонецЕсли;

	Файлы = Новый Массив;

	ПутьКЯзыку = ПутьКСоседнемуПакету(ФайлСинтаксисПомощника, "shlang");

	Если ЗначениеЗаполнено(ПутьКЯзыку) Тогда
		Файлы.Добавить(Новый Структура("ИмяФайла, ИмяХранилища", ПутьКЯзыку, "shlang"));
	КонецЕсли;

	Файлы.Добавить(Новый Структура("ИмяФайла, ИмяХранилища", ФайлСинтаксисПомощника, "shcntx"));

	Для Каждого ИмяПакета Из ПрофильныеПакетыСправки() Цикл

		ПутьКПакету = ПутьКСоседнемуПакету(ФайлСинтаксисПомощника, ИмяПакета);

		Если ЗначениеЗаполнено(ПутьКПакету) Тогда
			Файлы.Добавить(Новый Структура("ИмяФайла, ИмяХранилища", ПутьКПакету, ИмяПакета));
		КонецЕсли;

	КонецЦикла;

	ЗагрузкаСинтаксисПомощника = Новый Структура(
		"Файлы, Индекс, Поток, ИмяХранилища, Всего, ПереданоДанных, РазмерДанных, РазмерБуфера",
		Файлы, -1, Неопределено, "", 0, 0, 0, 0);

	ПоказатьСостояниеСинтаксисПомощника("начинаем передачу…");
	ПодключитьОбработчикОжидания("ШагЗагрузкиСинтаксисПомощника", 0.2, Истина);

КонецПроцедуры

// Порционный вариант ЗагрузитьФайлВРедактор из обработки автора: тот же цикл чтения,
// но по нескольку порций за такт обработчика ожидания.
&НаКлиенте
Процедура ШагЗагрузкиСинтаксисПомощника()

	Если ЗагрузкаСинтаксисПомощника = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка

		Если ЗагрузкаСинтаксисПомощника.Поток = Неопределено Тогда

			Если НЕ ОткрытьСледующийФайлСинтаксисПомощника() Тогда
				Возврат;
			КонецЕсли;

		КонецЕсли;

		РазмерПорции = РазмерПорцииСинтаксисПомощника();

		Для Такт = 1 По ПорцийЗаТакт() Цикл

			Если ЗагрузкаСинтаксисПомощника.РазмерБуфера <= 0 Тогда
				ЗавершитьПередачуФайлаСинтаксисПомощника();
				Прервать;
			КонецЕсли;

			Буфер = Новый БуферДвоичныхДанных(ЗагрузкаСинтаксисПомощника.РазмерБуфера);
			ЗагрузкаСинтаксисПомощника.Поток.Прочитать(Буфер, 0, ЗагрузкаСинтаксисПомощника.РазмерБуфера);

			ДанныеBase64 = ПолучитьBase64СтрокуИзБуфераДвоичныхДанных(Буфер);
			ДанныеBase64 = СтрЗаменить(ДанныеBase64, Символы.ПС, "");
			ДанныеBase64 = СтрЗаменить(ДанныеBase64, Символы.ВК, "");
			View().pushBase64Chunk(ДанныеBase64);

			ЗагрузкаСинтаксисПомощника.ПереданоДанных = ЗагрузкаСинтаксисПомощника.ПереданоДанных
				+ ЗагрузкаСинтаксисПомощника.РазмерБуфера;
			ЗагрузкаСинтаксисПомощника.РазмерДанных = ЗагрузкаСинтаксисПомощника.РазмерДанных - РазмерПорции;
			ЗагрузкаСинтаксисПомощника.РазмерБуфера = Мин(РазмерПорции, ЗагрузкаСинтаксисПомощника.РазмерДанных);

		КонецЦикла;

		Если ЗагрузкаСинтаксисПомощника <> Неопределено Тогда
			ПоказатьПрогрессЗагрузкиСинтаксисПомощника();
			ПодключитьОбработчикОжидания("ШагЗагрузкиСинтаксисПомощника", 0.2, Истина);
		КонецЕсли;

	Исключение
		ПрерватьЗагрузкуСинтаксисПомощника(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Функция ОткрытьСледующийФайлСинтаксисПомощника()

	ЗагрузкаСинтаксисПомощника.Индекс = ЗагрузкаСинтаксисПомощника.Индекс + 1;

	Если ЗагрузкаСинтаксисПомощника.Файлы.Количество() <= ЗагрузкаСинтаксисПомощника.Индекс Тогда
		ЗагрузкаСинтаксисПомощника = Неопределено;
		ПоказатьСостояниеСинтаксисПомощника("передача завершена, идёт разбор пакетов…");
		Возврат Ложь;
	КонецЕсли;

	Пакет = ЗагрузкаСинтаксисПомощника.Файлы[ЗагрузкаСинтаксисПомощника.Индекс];

	Поток = Новый ФайловыйПоток(Пакет.ИмяФайла, РежимОткрытияФайла.Открыть, ДоступКФайлу.Чтение);

	ЗагрузкаСинтаксисПомощника.Поток = Поток;
	ЗагрузкаСинтаксисПомощника.ИмяХранилища = Пакет.ИмяХранилища;
	ЗагрузкаСинтаксисПомощника.Всего = Поток.Размер();
	ЗагрузкаСинтаксисПомощника.ПереданоДанных = 0;
	ЗагрузкаСинтаксисПомощника.РазмерДанных = Поток.Размер();
	ЗагрузкаСинтаксисПомощника.РазмерБуфера = Мин(РазмерПорцииСинтаксисПомощника(), Поток.Размер());

	View().beginBase64Transfer(Пакет.ИмяХранилища);

	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура ЗавершитьПередачуФайлаСинтаксисПомощника()

	ЗагрузкаСинтаксисПомощника.Поток.Закрыть();
	ЗагрузкаСинтаксисПомощника.Поток = Неопределено;

	View().endBase64Transfer();
	View().parseHelp(); // панель не открываем: после разбора придёт EVENT_ON_HELP_READY

КонецПроцедуры

&НаКлиенте
Процедура ПрерватьЗагрузкуСинтаксисПомощника(ТекстОшибки)

	Если ЗагрузкаСинтаксисПомощника <> Неопределено Тогда

		Попытка
			Если ЗагрузкаСинтаксисПомощника.Поток <> Неопределено Тогда
				ЗагрузкаСинтаксисПомощника.Поток.Закрыть();
			КонецЕсли;
		Исключение
		КонецПопытки;

		// Незавершённая передача блокирует следующую — закрываем её, разбор при этом не запускаем.
		Попытка
			Если ЗагрузкаСинтаксисПомощника.Поток <> Неопределено Тогда
				View().endBase64Transfer();
			КонецЕсли;
		Исключение
		КонецПопытки;

		ЗагрузкаСинтаксисПомощника = Неопределено;

	КонецЕсли;

	ПоказатьСостояниеСинтаксисПомощника("ошибка загрузки — " + ТекстОшибки);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПрогрессЗагрузкиСинтаксисПомощника()

	Процент = 0;

	Если 0 < ЗагрузкаСинтаксисПомощника.Всего Тогда
		Процент = Цел(100 * ЗагрузкаСинтаксисПомощника.ПереданоДанных / ЗагрузкаСинтаксисПомощника.Всего);
	КонецЕсли;

	ПоказатьСостояниеСинтаксисПомощника("передача " + ЗагрузкаСинтаксисПомощника.ИмяХранилища
		+ " — " + Процент + "%");

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСостояниеСинтаксисПомощника(Текст)

	Элементы.СостояниеСинтаксисПомощника.Заголовок = "Синтаксис-помощник: " + Текст;

КонецПроцедуры

#КонецОбласти
