#Область СправкаHBK

// Загрузка штатных файлов синтакс-помощника платформы (shcntx_*.hbk — объектная модель,
// shlang_*.hbk — встроенный язык) в редактор. Файл читается порциями и уходит в поле через
// универсальный Base64-мост консоли (beginBase64Transfer / pushBase64Chunk / endBase64Transfer),
// после чего вызывается parseHelp(). Порции отдаются в обработчике ожидания, чтобы форма
// оставалась отзывчивой на файле объектной модели (~40 МБ).

&НаКлиенте
Функция РазмерПорцииСправки()

	Возврат 1048576;

КонецФункции

&НаКлиенте
Функция ПорцийЗаТактЗагрузкиСправки()

	Возврат 4;

КонецФункции

&НаКлиенте
Процедура ИнициализироватьНастройкиСправки()

	#Если ВебКлиент Тогда
		Элементы.ГруппаНастроекСправка.Видимость = Ложь;
		Возврат;
	#КонецЕсли

	Если НЕ ЗначениеЗаполнено(ФайлСправки1С) Тогда
		ФайлСправки1С = НайтиФайлСправкиПлатформы();
	КонецЕсли;

	Если ЗначениеЗаполнено(ФайлСправки1С) Тогда
		ПоказатьСостояниеСправки("файл найден, справка ещё не загружена");
	Иначе
		ПоказатьСостояниеСправки("файл shcntx_*.hbk не найден, укажите путь вручную");
	КонецЕсли;

КонецПроцедуры

// Ищет пакет объектной модели там, где его кладёт платформа: сначала каталог запущенного
// приложения, затем соседние каталоги версий этой же установки.
&НаКлиенте
Функция НайтиФайлСправкиПлатформы()

	Каталоги = КаталогиПоискаСправки();

	Для Каждого Каталог Из Каталоги Цикл

		Путь = Каталог + "shcntx_ru.hbk";

		Если Новый Файл(Путь).Существует() Тогда
			Возврат Путь;
		КонецЕсли;

	КонецЦикла;

	Возврат "";

КонецФункции

&НаКлиенте
Функция КаталогиПоискаСправки()

	Разделитель = ПолучитьРазделительПути();
	Каталоги = Новый Массив;

	Попытка
		Каталоги.Добавить(ДополнитьРазделителем(КаталогПрограммы(), Разделитель));
	Исключение
		// каталог программы недоступен — остаётся ручной выбор файла
	КонецПопытки;

	Если 0 = Каталоги.Количество() Тогда
		Возврат Каталоги;
	КонецЕсли;

	// bin -> <версия> -> корень установки платформы; версии перебираем от свежих к старым
	// (сортировка строковая, поэтому она лишь дополняет каталог запущенного приложения).
	КаталогВерсии = Новый Файл(Лев(Каталоги[0], СтрДлина(Каталоги[0]) - 1)).Путь;
	КореньУстановки = Новый Файл(Лев(КаталогВерсии, СтрДлина(КаталогВерсии) - 1)).Путь;

	Если НЕ ЗначениеЗаполнено(КореньУстановки) Тогда
		Возврат Каталоги;
	КонецЕсли;

	Версии = Новый СписокЗначений;

	Попытка
		Найденные = НайтиФайлы(КореньУстановки, "*", Ложь);
	Исключение
		Найденные = Новый Массив;
	КонецПопытки;

	Для Каждого Найденный Из Найденные Цикл
		Если Найденный.ЭтоКаталог() Тогда
			Версии.Добавить(ДополнитьРазделителем(Найденный.ПолноеИмя, Разделитель) + "bin" + Разделитель);
		КонецЕсли;
	КонецЦикла;

	Версии.СортироватьПоЗначению(НаправлениеСортировки.Убыв);

	Для Каждого Элемент Из Версии Цикл
		Если Каталоги.Найти(Элемент.Значение) = Неопределено Тогда
			Каталоги.Добавить(Элемент.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Каталоги;

КонецФункции

&НаКлиенте
Функция ДополнитьРазделителем(Путь, Разделитель)

	Возврат ?(Прав(Путь, 1) = Разделитель, Путь, Путь + Разделитель);

КонецФункции

// Пакет встроенного языка лежит рядом с объектной моделью и отличается только именем.
&НаКлиенте
Функция ПутьКПакетуВстроенногоЯзыка(ПутьКОбъектнойМодели)

	Файл = Новый Файл(ПутьКОбъектнойМодели);

	Если СтрНайти(НРег(Файл.Имя), "shcntx") = 0 Тогда
		Возврат "";
	КонецЕсли;

	ПутьКЯзыку = Файл.Путь + СтрЗаменить(НРег(Файл.Имя), "shcntx", "shlang");

	Возврат ?(Новый Файл(ПутьКЯзыку).Существует(), ПутьКЯзыку, "");

КонецФункции

&НаКлиенте
Процедура ФайлСправки1СНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Оповещение = Новый ОписаниеОповещения("ВыборФайлаСправкиЗавершение", ЭтотОбъект);
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите файл справки 1С (shcntx_*.hbk)";
	Диалог.Фильтр = "Файлы справки 1С (*.hbk)|*.hbk";
	Диалог.МножественныйВыбор = Ложь;
	Диалог.ПолноеИмяФайла = ФайлСправки1С;
	Диалог.Показать(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ВыборФайлаСправкиЗавершение(ВыбранныеФайлы, ДопПараметры) Экспорт

	Если ВыбранныеФайлы <> Неопределено И 0 < ВыбранныеФайлы.Количество() Тогда
		ФайлСправки1С = ВыбранныеФайлы[0];
		ПоказатьСостояниеСправки("файл выбран, нажмите «Загрузить справку»");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСправку(Команда)

	НачатьЗагрузкуСправки();

КонецПроцедуры

&НаКлиенте
Процедура АвтозапускЗагрузкиСправки()

	Если ЗагружатьСправкуПриОткрытии И ЗначениеЗаполнено(ФайлСправки1С) Тогда
		НачатьЗагрузкуСправки();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НачатьЗагрузкуСправки()

	Если ЗагрузкаСправки <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ДокументЗагружен Тогда
		ПоказатьСостояниеСправки("редактор ещё не готов, повторите позже");
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ФайлСправки1С) Тогда
		ПоказатьСостояниеСправки("не указан файл справки");
		Возврат;
	КонецЕсли;

	ФайлОбъектнойМодели = Новый Файл(ФайлСправки1С);

	Если НЕ ФайлОбъектнойМодели.Существует() Тогда
		ПоказатьСостояниеСправки("файл не найден: " + ФайлСправки1С);
		Возврат;
	КонецЕсли;

	Пакеты = Новый Массив;

	ПутьКЯзыку = ПутьКПакетуВстроенногоЯзыка(ФайлСправки1С);

	Если ЗначениеЗаполнено(ПутьКЯзыку) Тогда
		Пакеты.Добавить(ОписаниеПакетаСправки("shlang", ПутьКЯзыку));
	КонецЕсли;

	Пакеты.Добавить(ОписаниеПакетаСправки("shcntx", ФайлСправки1С));

	ЗагрузкаСправки = Новый Структура("Пакеты, Индекс, Поток, Имя, Всего, Передано, Открыт",
		Пакеты, -1, Неопределено, "", 0, 0, Ложь);

	ПоказатьСостояниеСправки("начинаем передачу…");
	ПодключитьОбработчикОжидания("ШагЗагрузкиСправки", 0.2, Истина);

КонецПроцедуры

&НаКлиенте
Функция ОписаниеПакетаСправки(Имя, Путь)

	Возврат Новый Структура("Имя, Путь, Размер", Имя, Путь, Новый Файл(Путь).Размер());

КонецФункции

&НаКлиенте
Процедура ШагЗагрузкиСправки()

	Если ЗагрузкаСправки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка

		Если НЕ ЗагрузкаСправки.Открыт Тогда

			ЗагрузкаСправки.Индекс = ЗагрузкаСправки.Индекс + 1;

			Если ЗагрузкаСправки.Пакеты.Количество() <= ЗагрузкаСправки.Индекс Тогда
				ЗагрузкаСправки = Неопределено;
				ПоказатьСостояниеСправки("передача завершена, идёт разбор пакетов…");
				Возврат;
			КонецЕсли;

			Пакет = ЗагрузкаСправки.Пакеты[ЗагрузкаСправки.Индекс];

			ЗагрузкаСправки.Поток = Новый ЧтениеДанных(Пакет.Путь);
			ЗагрузкаСправки.Имя = Пакет.Имя;
			ЗагрузкаСправки.Всего = Пакет.Размер;
			ЗагрузкаСправки.Передано = 0;
			ЗагрузкаСправки.Открыт = Истина;

			View().beginBase64Transfer(Пакет.Имя);

		КонецЕсли;

		Для Такт = 1 По ПорцийЗаТактЗагрузкиСправки() Цикл

			Порция = ЗагрузкаСправки.Поток.Прочитать(РазмерПорцииСправки()).ПолучитьДвоичныеДанные();
			Прочитано = Порция.Размер();

			Если 0 < Прочитано Тогда
				View().pushBase64Chunk(Base64Строка(Порция));
				ЗагрузкаСправки.Передано = ЗагрузкаСправки.Передано + Прочитано;
			КонецЕсли;

			Если Прочитано < РазмерПорцииСправки() Тогда
				ЗавершитьПакетСправки();
				Прервать;
			КонецЕсли;

		КонецЦикла;

		Если ЗагрузкаСправки <> Неопределено Тогда
			ПоказатьПрогрессЗагрузкиСправки();
			ПодключитьОбработчикОжидания("ШагЗагрузкиСправки", 0.2, Истина);
		КонецЕсли;

	Исключение
		ПрерватьЗагрузкуСправки(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьПакетСправки()

	View().endBase64Transfer();
	View().parseHelp();

	ЗагрузкаСправки.Поток.Закрыть();
	ЗагрузкаСправки.Поток = Неопределено;
	ЗагрузкаСправки.Открыт = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ПрерватьЗагрузкуСправки(ТекстОшибки)

	Если ЗагрузкаСправки <> Неопределено Тогда

		Попытка
			Если ЗагрузкаСправки.Поток <> Неопределено Тогда
				ЗагрузкаСправки.Поток.Закрыть();
			КонецЕсли;
		Исключение
		КонецПопытки;

		// Незавершённая передача блокирует следующую — закрываем её, разбор при этом не запускаем.
		Попытка
			Если ЗагрузкаСправки.Открыт Тогда
				View().endBase64Transfer();
			КонецЕсли;
		Исключение
		КонецПопытки;

		ЗагрузкаСправки = Неопределено;

	КонецЕсли;

	ПоказатьСостояниеСправки("ошибка загрузки — " + ТекстОшибки);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПрогрессЗагрузкиСправки()

	Процент = 0;

	Если 0 < ЗагрузкаСправки.Всего Тогда
		Процент = Цел(100 * ЗагрузкаСправки.Передано / ЗагрузкаСправки.Всего);
	КонецЕсли;

	ПоказатьСостояниеСправки("передача " + ЗагрузкаСправки.Имя + " — " + Процент + "%");

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСостояниеСправки(Текст)

	Элементы.СостояниеСправкиНадпись.Заголовок = "Справка 1С: " + Текст;

КонецПроцедуры

#КонецОбласти
