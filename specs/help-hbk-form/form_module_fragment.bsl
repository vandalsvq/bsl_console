#Область СинтаксисПомощник

// Загрузка штатных пакетов синтакс-помощника платформы через Base64-мост консоли.
// База — реализация автора: ПолучитьФайлСправки и ЗагрузитьФайлВРедактор порциями по 1 МБ.
// Наше поверх: путь к shcntx хранится в настройках формы и подбирается автоматически (в том числе
// в соседних каталогах версий платформы); рядом подхватываются пакеты встроенного языка, языка
// запросов и СКД; ход передачи и разбора виден в надписи под настройками.

&НаКлиенте
Асинх Функция ПолучитьФайлСправки(ИмяФайла)

	Результат = Ждать НайтиФайлыАсинх(КаталогПрограммы(), ИмяФайла, Ложь);

	Если 0 < Результат.Количество() Тогда
		Возврат Результат[0];
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Профильные пакеты справки: язык запросов (режим bsl_query) и СКД (режим dcs_query).
&НаКлиенте
Функция ПрофильныеПакетыСправки()

	Пакеты = Новый Массив;
	Пакеты.Добавить("shquery");
	Пакеты.Добавить("dcsui");

	Возврат Пакеты;

КонецФункции

&НаКлиенте
Асинх Процедура ИнициализироватьНастройкиСинтаксисПомощника()

	#Если ВебКлиент Тогда
		Элементы.ГруппаНастроекСинтаксисПомощник.Видимость = Ложь;
		Возврат;
	#КонецЕсли

	Если НЕ ЗначениеЗаполнено(ФайлСинтаксисПомощника) Тогда
		ФайлСинтаксисПомощника = Ждать НайтиФайлСинтаксисПомощника();
	КонецЕсли;

	Если ЗначениеЗаполнено(ФайлСинтаксисПомощника) Тогда
		ПоказатьСостояниеСинтаксисПомощника("файл найден, ещё не загружен");
	Иначе
		ПоказатьСостояниеСинтаксисПомощника("файл shcntx_*.hbk не найден, укажите путь вручную");
	КонецЕсли;

КонецПроцедуры

// Пакет объектной модели лежит там, где его кладёт платформа: сначала каталог запущенного
// приложения (как в обработке автора), затем соседние каталоги версий этой же установки.
&НаКлиенте
Асинх Функция НайтиФайлСинтаксисПомощника()

	Файл = Ждать ПолучитьФайлСправки("shcntx_ru.hbk");

	Если Файл <> Неопределено Тогда
		Возврат Файл.ПолноеИмя;
	КонецЕсли;

	Каталоги = Ждать КаталогиСоседнихВерсийПлатформы();

	Для Каждого Каталог Из Каталоги Цикл

		Найденные = Ждать НайтиФайлыАсинх(Каталог, "shcntx_ru.hbk", Ложь);

		Если 0 < Найденные.Количество() Тогда
			Возврат Найденные[0].ПолноеИмя;
		КонецЕсли;

	КонецЦикла;

	Возврат "";

КонецФункции

&НаКлиенте
Асинх Функция КаталогиСоседнихВерсийПлатформы()

	Разделитель = ПолучитьРазделительПути();
	Каталоги = Новый Массив;

	Попытка
		КаталогПриложения = ДополнитьРазделителем(КаталогПрограммы(), Разделитель);
	Исключение
		// каталог программы недоступен — остаётся ручной выбор файла
		Возврат Каталоги;
	КонецПопытки;

	// bin -> <версия> -> корень установки платформы; версии перебираем от свежих к старым
	// (сортировка строковая, поэтому она лишь дополняет каталог запущенного приложения).
	ФайлКаталогаBin = Новый Файл(Лев(КаталогПриложения, СтрДлина(КаталогПриложения) - 1));
	КаталогВерсии = ФайлКаталогаBin.Путь;

	ФайлКаталогаВерсии = Новый Файл(Лев(КаталогВерсии, СтрДлина(КаталогВерсии) - 1));
	КореньУстановки = ФайлКаталогаВерсии.Путь;

	Если НЕ ЗначениеЗаполнено(КореньУстановки) Тогда
		Возврат Каталоги;
	КонецЕсли;

	Попытка
		Найденные = Ждать НайтиФайлыАсинх(КореньУстановки, "*", Ложь);
	Исключение
		Возврат Каталоги;
	КонецПопытки;

	Версии = Новый СписокЗначений;

	Для Каждого Найденный Из Найденные Цикл
		Если Найденный.ЭтоКаталог() Тогда
			Версии.Добавить(ДополнитьРазделителем(Найденный.ПолноеИмя, Разделитель) + "bin" + Разделитель);
		КонецЕсли;
	КонецЦикла;

	Версии.СортироватьПоЗначению(НаправлениеСортировки.Убыв);

	Для Каждого Элемент Из Версии Цикл
		Если Элемент.Значение <> КаталогПриложения Тогда
			Каталоги.Добавить(Элемент.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Каталоги;

КонецФункции

&НаКлиенте
Функция ДополнитьРазделителем(Путь, Разделитель)

	Возврат ?(Прав(Путь, 1) = Разделитель, Путь, Путь + Разделитель);

КонецФункции

// Остальные пакеты платформы лежат рядом с объектной моделью и отличаются только префиксом имени.
&НаКлиенте
Асинх Функция ПутьКСоседнемуПакету(ПутьКОбъектнойМодели, ИмяПакета)

	Файл = Новый Файл(ПутьКОбъектнойМодели);
	ИмяФайла = НРег(Файл.Имя);

	Если СтрНайти(ИмяФайла, "shcntx") = 0 Тогда
		Возврат "";
	КонецЕсли;

	Найденные = Ждать НайтиФайлыАсинх(Файл.Путь, СтрЗаменить(ИмяФайла, "shcntx", ИмяПакета), Ложь);

	Возврат ?(0 < Найденные.Количество(), Найденные[0].ПолноеИмя, "");

КонецФункции

&НаКлиенте
Асинх Функция ЗагрузитьДанныеСинтаксПомощника()

	Если НЕ ЗначениеЗаполнено(ФайлСинтаксисПомощника) Тогда
		ПоказатьСостояниеСинтаксисПомощника("не указан файл");
		Возврат Ложь;
	КонецЕсли;

	Пакеты = Новый Массив;

	// встроенный язык идёт первым: он мелкий, подсказка по языку появляется почти сразу
	ПутьКЯзыку = Ждать ПутьКСоседнемуПакету(ФайлСинтаксисПомощника, "shlang");

	Если ЗначениеЗаполнено(ПутьКЯзыку) Тогда
		Пакеты.Добавить(Новый Структура("ИмяФайла, ИмяХранилища", ПутьКЯзыку, "shlang"));
	КонецЕсли;

	Пакеты.Добавить(Новый Структура("ИмяФайла, ИмяХранилища", ФайлСинтаксисПомощника, "shcntx"));

	Для Каждого ИмяПакета Из ПрофильныеПакетыСправки() Цикл

		ПутьКПакету = Ждать ПутьКСоседнемуПакету(ФайлСинтаксисПомощника, ИмяПакета);

		Если ЗначениеЗаполнено(ПутьКПакету) Тогда
			Пакеты.Добавить(Новый Структура("ИмяФайла, ИмяХранилища", ПутьКПакету, ИмяПакета));
		КонецЕсли;

	КонецЦикла;

	Загружено = Ложь;

	Для Каждого Пакет Из Пакеты Цикл

		ПоказатьСостояниеСинтаксисПомощника("передача " + Пакет.ИмяХранилища + "...");

		Попытка
			Передан = Ждать ЗагрузитьФайлВРедактор(Пакет.ИмяФайла, Пакет.ИмяХранилища);
		Исключение
			ПрерватьЗагрузкуСинтаксисПомощника(Пакет.ИмяХранилища, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат Загружено;
		КонецПопытки;

		Если Передан Тогда
			View().parseHelp(); // панель не открываем: о готовности сообщат события справки
			Загружено = Истина;
		КонецЕсли;

	КонецЦикла;

	Если Загружено Тогда
		ПоказатьСостояниеСинтаксисПомощника("передача завершена, идёт разбор пакетов...");
	КонецЕсли;

	Возврат Загружено;

КонецФункции

// Незавершённая передача блокирует следующую — закрываем её, разбор при этом не запускаем.
&НаКлиенте
Процедура ПрерватьЗагрузкуСинтаксисПомощника(ИмяХранилища, ТекстОшибки)

	Попытка
		View().endBase64Transfer();
	Исключение
	КонецПопытки;

	ПоказатьСостояниеСинтаксисПомощника("ошибка передачи " + ИмяХранилища + " — " + ТекстОшибки);

КонецПроцедуры

&НаКлиенте
Асинх Процедура АвтозапускЗагрузкиСинтаксисПомощника()

	Если ЗагружатьСинтаксисПомощникПриОткрытии И ЗначениеЗаполнено(ФайлСинтаксисПомощника) Тогда
		Ждать ЗагрузитьДанныеСинтаксПомощника();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ФайлСинтаксисПомощникаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Оповещение = Новый ОписаниеОповещения("ВыборФайлаСинтаксисПомощникаЗавершение", ЭтотОбъект);
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите файл синтакс-помощника (shcntx_*.hbk)";
	Диалог.Фильтр = "Файлы справки 1С (*.hbk)|*.hbk";
	Диалог.МножественныйВыбор = Ложь;
	Диалог.ПолноеИмяФайла = ФайлСинтаксисПомощника;
	Диалог.Показать(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ВыборФайлаСинтаксисПомощникаЗавершение(ВыбранныеФайлы, ДопПараметры) Экспорт

	Если ВыбранныеФайлы <> Неопределено И 0 < ВыбранныеФайлы.Количество() Тогда
		ФайлСинтаксисПомощника = ВыбранныеФайлы[0];
		ПоказатьСостояниеСинтаксисПомощника("файл выбран, нажмите «Загрузить синтаксис-помощник»");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПрогрессПередачиСинтаксисПомощника(ИмяХранилища, Передано, Всего)

	Процент = 0;

	Если 0 < Всего Тогда
		Процент = Цел(100 * Передано / Всего);
	КонецЕсли;

	ПоказатьСостояниеСинтаксисПомощника("передача " + ИмяХранилища + " — " + Процент + "%");

КонецПроцедуры

&НаКлиенте
Функция ОписаниеПакетаСправки(Параметры)

	Вид = "";

	// params приходит из редактора объектом браузера, а не структурой 1С, поэтому читаем через Попытка
	Попытка
		Вид = Строка(Параметры.kind);
	Исключение
	КонецПопытки;

	Если Вид = "query" Тогда
		Возврат "язык запросов";
	ИначеЕсли Вид = "dcs" Тогда
		Возврат "СКД";
	КонецЕсли;

	Возврат "объектная модель";

КонецФункции

&НаКлиенте
Процедура ПоказатьСостояниеСинтаксисПомощника(Текст)

	Элементы.СостояниеСинтаксисПомощника.Заголовок = "Синтаксис-помощник: " + Текст;

КонецПроцедуры

#КонецОбласти
